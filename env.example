export DJANGO_PORT=8000
export DJANGO_PARAMS=""
export DJANGO_DEBUG="True"
export DJANGO_PREFIX_API="http://localhost:8000/api"

# Used by init.sh to create the first superuser non-interactively
export DJANGO_SUPERUSER_USERNAME=admin
export DJANGO_SUPERUSER_EMAIL=admin@example.com
export DJANGO_SUPERUSER_PASSWORD=[superuser password]

export POSTGRES_HOST=[domain/ip/container database]
export POSTGRES_USER=[username database]
export POSTGRES_PASSWORD=[password database]
export POSTGRES_DB=sensoriando
export POSTGRES_PORT=5432

