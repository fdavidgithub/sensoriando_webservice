# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------
# Compoe o prefixo de todo recurso na AWS (sensoriando_<ambiente>) e o caminho
# no Parameter Store. E o que permite development e test coexistirem na mesma
# conta AWS sem colisao de nomes.
export SENSORIANDO_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# AWS
# ---------------------------------------------------------------------------
export AWS_REGION=us-east-2
export AWS_PROFILE=sensoriando



# ---------------------------------------------------------------------------
# Nao ha mais variaveis de banco nem de Django aqui: este repositorio nao fala
# com o PostgreSQL. A URL da API e descoberta no build pelo output da stack
# sensoriando-<ambiente>-api no CloudFormation, e nao por variavel.
